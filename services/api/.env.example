# ---------------------------------------------------------------------------
# LEGALMET AI — API service environment. Copy to `.env` and adjust.
# NEVER commit the real `.env`. Do not put production secrets in source control.
# ---------------------------------------------------------------------------

# Environment: development | test | production
ENVIRONMENT=development
DEBUG=true

# --- Database --------------------------------------------------------------
# Zero-config dev/test default is SQLite (no external service needed):
DATABASE_URL=sqlite:///./legalmet.db
# Production (PostgreSQL) — use docker-compose or a managed instance:
# DATABASE_URL=postgresql+psycopg2://legalmet:legalmet@localhost:5432/legalmet

# --- Security --------------------------------------------------------------
# CHANGE THIS in any non-development environment. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_ALGORITHM=HS256

# --- CORS (comma-separated origins) ---------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage (S3-compatible abstraction; 'local' for dev) -----------------
STORAGE_BACKEND=local
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760

# --- Demo data seeding -----------------------------------------------------
# Seeds clearly-labelled DEMO users/rules on startup. DEMO ONLY — override
# these credentials and disable seeding for any real deployment.
SEED_DEMO_DATA=true
DEMO_ADMIN_EMAIL=admin@legalmet.local
DEMO_ADMIN_PASSWORD=changeme-admin
DEMO_INSPECTOR_EMAIL=inspector@legalmet.local
DEMO_INSPECTOR_PASSWORD=changeme-inspector

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# true = JSON logs (production), false = human-readable console logs (dev)
LOG_JSON=false
