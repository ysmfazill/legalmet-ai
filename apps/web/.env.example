# ---------------------------------------------------------------------------
# @legalmet/web — frontend environment. Copy to `.env.local` (git-ignored).
# ---------------------------------------------------------------------------

# Base URL the API client prepends to every request.
#   - Leave as `/api/v1` in local dev: Vite proxies `/api` -> http://localhost:8000
#   - Set to an absolute URL (e.g. https://api.example.com/api/v1) for deploys.
VITE_API_BASE_URL=/api/v1
